#══════════════════════════════════════════════════════════════════════════════
#  ASSISTANT — configuration
#
#  TO FILL IN: your OpenAI API key (section 1), plus DATABASE_URL and
#  BLOB_READ_WRITE_TOKEN (section 2). The Google client is already set.
#
#  Restart the app after editing.
#══════════════════════════════════════════════════════════════════════════════


#──────────────────────── 1. OPENAI (required) ────────────────────────────────
# https://platform.openai.com/api-keys → "Create new secret key".
# Starts with sk-. Read only on the server, never sent to the browser.
OPENAI_API_KEY=sk-REPLACE-ME

#  ^^^ PASTE YOUR KEY HERE — no quotes, no spaces



#──────────────────── 2. DATABASE + FILE STORAGE (required) ───────────────────
# Postgres. Use the POOLED connection string — serverless opens many short-lived
# connections and a direct one runs out of slots.
#   Vercel  → Storage → Create → Postgres, then copy POSTGRES_URL
#   Neon    → neon.tech, copy the "Pooled connection" string
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# Where uploaded tax documents live. The runtime has no writable disk.
#   Vercel → Storage → Create → Blob, then copy the read/write token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE_ME

# `vercel env pull` writes both of these into .env.local automatically once the
# stores are linked to the project, so locally you can leave them blank here.

#──────────────────── 3. SIGN-IN (Google) ─────────────────────────────────────
# Everyone signs in with their work Google account. There are no passwords.
#
# The OAuth client below is already set up. If you ever need to recreate it:
#   1. https://console.cloud.google.com/apis/credentials
#   2. Create Credentials → OAuth client ID → Web application
#   3. Authorised redirect URI — paste EXACTLY, including the path:
#
#          http://localhost:3100/api/auth/callback/google
#
#      (Add your real domain's version of the same path once hosted.)
AUTH_GOOGLE_ID=REPLACE-ME.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-REPLACE-ME

# Signs the session cookie. Generate a fresh one for production with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=generate-with-the-command-above

# Uncomment and set to the real URL once this is hosted somewhere.
# AUTH_URL=https://chat.usaindiacfo.com

#  ── WHO CAN SIGN IN ──────────────────────────────────────────────────────────
#  A Google login only proves an email address; it does not grant access.
#  Access comes from the people list in Admin → People. Google will happily
#  authenticate any account on earth, so that list is what keeps strangers out.
#
#  Optional extra fence: only addresses at this domain may sign in at all.
#  Leave blank to allow any domain (the people list still applies).
ALLOWED_EMAIL_DOMAIN=usaindiacfo.com

#  Admins. Anyone listed here signs in straight away — no invitation needed —
#  and is created as (or promoted to) an admin. List as many as you like,
#  separated by commas.
#
#  Grant-only: taking someone off this list does NOT demote them, because
#  silently losing access on next sign-in would be baffling. Demote or
#  deactivate through Admin -> People instead.
#
#  If this is empty, nobody can sign in at all — there would be no admin to
#  invite anyone.
ADMIN_EMAILS=you@yourfirm.com,colleague@yourfirm.com


#──────────────────────── 4. MODEL ────────────────────────────────────────────
# Cost per 1M tokens (in / out):
#   gpt-5.6-luna   $0.20 / $1.20    ← current
#   gpt-5.6-terra  $2.00 / $12.00
#   gpt-5.6-sol    $4.00 / $20.00
OPENAI_CHAT_MODEL=gpt-5.6-luna

# How hard the model thinks: low | medium | high | xhigh | max
# The fallback only. Everyone picks Off / Standard / Extended per conversation,
# and sets their own default under Settings; this is what applies to neither.
MODEL_EFFORT=medium

# All three models above appear in the composer's picker. OPENAI_CHAT_MODEL is
# where a new conversation starts for someone who has not chosen a default.

# Ceiling on one answer. An answer that hits it is offered a Continue button
# rather than being silently truncated.
MAX_OUTPUT_TOKENS=16000

# Tools the model may call mid-answer: run_analysis, remember, forget.
# Set false to remove all three everywhere.
TOOLS_ENABLED=true

# How many times the model may call tools and be asked again within one turn.
# The whole turn shares one 300s request budget on Vercel, so this is a real
# ceiling, not a formality.
MAX_TOOL_ROUNDS=4

# Wall-clock limit on one analysis script. Synchronous code only — there are no
# timers inside the sandbox for it to wait on.
ANALYSIS_TIMEOUT_MS=5000

# Most remembered facts carried into a conversation, newest first. Each one is
# sent on every message, so this is a bill as well as a limit.
MEMORY_LIMIT=60


#──────────────────────── 5. WHERE IT RUNS ────────────────────────────────────
# Local dev only — Vercel ignores this and serves on its own port/domain.
# Port 3000 is used by your other projects (bng-command-center, Growth-center).
# If you change this, update the Google redirect URI to match.
PORT=3100

# Chat runs up to 300s (see vercel.json and the `maxDuration` export in
# app/api/chat/route.ts). 300s is the ceiling on every Vercel plan, Hobby
# included — a route asking for more fails the build.



#──────────────────────── 6. DATA PROTECTION ──────────────────────────────────
# tokenize (default) — SSNs, EINs, account, routing and card numbers found in
#   Word/Excel/CSV text are replaced with stable pseudonyms like [SSN-a3f2]
#   before anything is sent out. The same value always gets the same token, so
#   matching records across documents still works.
# off — send converted text unchanged.
#
# IMPORTANT: this cannot mask PDFs or images. Those are sent as pages and
# pixels, and the model reads the number off the scan directly. It reduces
# exposure; it does not remove PII.
PII_MODE=tokenize

# Days to keep uploaded original documents. Conversations and the audit log are
# kept regardless — only the source files expire. Purge them from
# Admin → Usage & cost → Document retention. Set to 0 to keep files forever.
RETENTION_ORIGINALS_DAYS=90


#──────────────────────────── 7. LIMITS ───────────────────────────────────────
# Largest single upload request, in bytes. 104857600 = 100 MB.
MAX_UPLOAD_BYTES=104857600

# Largest PDF accepted in one message. Over this, the file is refused with the
# real page count rather than being silently truncated.
MAX_PDF_PAGES=600


#──────────────────── 8. LOCAL PREVIEW (leave false normally) ─────────────────
# true  — skips Google sign-in entirely and treats every visitor as an admin,
#         so you can click through the pages without OAuth. Localhost only.
#         The test suite refuses to run while this is on.
# false — normal Google sign-in.
DISABLE_AUTH=false


#──────────────────────── 9. CONNECTORS ───────────────────────────────────────
# Remote MCP servers whose tools the model may call. Added and approved by an
# admin under Admin -> Connectors; switched on per conversation by each person.
#
# Set false to remove every connector from every conversation without deleting
# the configuration. The switch to reach for if one misbehaves.
CONNECTORS_ENABLED=true

# How long one connector request may take before it is abandoned. The whole
# turn shares a 300s budget on Vercel, so a slow connector eats the answer.
MCP_TIMEOUT_MS=30000


#──────────────────── 10. CONNECTED ACCOUNTS (Drive, Gmail, Box) ──────────────
# Each person signs in to their own account under Settings -> Accounts. Tokens
# are stored encrypted with a key derived from AUTH_SECRET, so a database dump
# on its own cannot use them. Rotating AUTH_SECRET invalidates every stored
# token and everyone reconnects, which is the correct behaviour.
#
# All scopes are read-only. Nothing here can send mail or change a file.

#  ── GOOGLE DRIVE AND GMAIL ───────────────────────────────────────────────────
#  These reuse the Google client above. To turn them on, in the SAME Cloud
#  project:
#    1. APIs & Services -> Library -> enable "Google Drive API" and "Gmail API"
#    2. OAuth consent screen -> add the scopes:
#         .../auth/drive.readonly
#         .../auth/gmail.readonly
#         .../auth/userinfo.email
#       gmail.readonly is a RESTRICTED scope. An Internal Workspace app can use
#       it straight away; a public app needs Google to review it first.
#    3. Credentials -> your OAuth client -> add these redirect URIs exactly:
#         http://localhost:3100/api/accounts/drive/callback
#         http://localhost:3100/api/accounts/gmail/callback
#       (plus the https versions on your real domain)
#
#  To use a SEPARATE Google client for these rather than the sign-in one:
# GOOGLE_WORKSPACE_CLIENT_ID=
# GOOGLE_WORKSPACE_CLIENT_SECRET=

#  ── BOX ──────────────────────────────────────────────────────────────────────
#  developer.box.com -> My Apps -> Create -> Custom App -> User Authentication
#  (OAuth 2.0). Give it read-only content scopes, then add this redirect URI:
#         http://localhost:3100/api/accounts/box/callback
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# Overrides the key used to encrypt stored account tokens. Leave blank to
# derive it from AUTH_SECRET, which is what you want unless you have a reason.
# TOKEN_ENCRYPTION_KEY=
